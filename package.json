{
  "name": "staticerson-portfolio",
  "version": "2.0.0",
  "description": "Jason Tyler Rodriguez \u2014 front-end engineering and UX",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components content lib --max-warnings 0",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit",
    "ci": "npm run type-check && npm run lint && npm run build",
    "test:e2e": "playwright test --update-snapshots=none",
    "test:visual": "playwright test --grep @visual --update-snapshots=none",
    "test:visual:update": "playwright test --grep @visual --update-snapshots=all",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "next": "^16.2.10",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.0.0",
    "postcss": "^8.4.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
